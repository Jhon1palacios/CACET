@{ ViewData["Title"] = "Estadísticas"; }

<div class="page-header">
    <div class="page-header-title">
        <h1>Estadísticas</h1>
        <p>Reportes gráficos y numéricos en tiempo real</p>
    </div>
</div>

<div class="kpi-grid">
    <div class="kpi-card">
        <div class="kpi-icon" style="background: rgba(13,110,253,0.12); color: #0d6efd;"><i class="bi bi-briefcase"></i></div>
        <div>
            <div class="kpi-value">@ViewBag.TotalCasos</div>
            <div class="kpi-label">Total Casos Activos</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background: rgba(148,163,184,0.15); color: #475569;"><i class="bi bi-check-circle"></i></div>
        <div>
            <div class="kpi-value">@ViewBag.Finalizados</div>
            <div class="kpi-label">Finalizados</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background: rgba(251,191,36,0.15); color: #78350f;"><i class="bi bi-clock-history"></i></div>
        <div>
            <div class="kpi-value">@ViewBag.EnTramite</div>
            <div class="kpi-label">En Trámite</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background: rgba(34,197,94,0.12); color: #15803d;"><i class="bi bi-handshake"></i></div>
        <div>
            <div class="kpi-value">@ViewBag.Acuerdos</div>
            <div class="kpi-label">Acuerdos de Pago</div>
        </div>
    </div>
</div>

<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 20px; margin-top: 20px;">
    <div class="table-card" style="padding: 20px;">
        <div class="table-card-header" style="border-bottom: none; padding-bottom: 0;">
            <span class="table-card-title">Casos por Tipo de Proceso</span>
        </div>
        <div style="height: 300px; width: 100%; margin-top: 15px; display: flex; justify-content: center;">
            <canvas id="barChart"></canvas>
        </div>
    </div>
    <div class="table-card" style="padding: 20px;">
        <div class="table-card-header" style="border-bottom: none; padding-bottom: 0;">
            <span class="table-card-title">Distribución</span>
        </div>
        <div style="height: 250px; width: 100%; margin-top: 15px; display: flex; justify-content: center;">
            <canvas id="doughnutChart"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Data passed from controller
            const labels = [@Html.Raw(ViewBag.TiposProcesoLabels)];
            const data = [@Html.Raw(ViewBag.TiposProcesoData)];
            
            const backgroundColors = [
                'rgba(249,115,22,0.7)', // ejecutivo
                'rgba(251,146,60,0.7)', // concursal
                'rgba(253,186,116,0.7)', // ordinario
                'rgba(251,191,36,0.7)',  // monitorio
                'rgba(96,165,250,0.7)'   // voluntario
            ];

            // Bar Chart
            const ctxBar = document.getElementById('barChart').getContext('2d');
            new Chart(ctxBar, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Número de Casos',
                        data: data,
                        backgroundColor: backgroundColors,
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
                }
            });

            // Doughnut Chart
            const ctxDoughnut = document.getElementById('doughnutChart').getContext('2d');
            new Chart(ctxDoughnut, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: data,
                        backgroundColor: backgroundColors,
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });
        });
    </script>
}
